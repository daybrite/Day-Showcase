# The Stack page's large sheet, locked sheet and status bar switch (src/pages/stack.rs).

stack_large_button = Large sheet
stack_large_title = Large sheet
stack_locked_button = Locked sheet
stack_locked_title = Locked sheet
stack_locked_toggle = Ignore Escape, pull-down and Back
stack_status_bar = Hide the status bar
stack_status_bar_none = Windows on this platform have no status bar.
