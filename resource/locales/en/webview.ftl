# The Web View page's page messages (src/pages/webview.rs).

webview_message_none = No message from the page yet.
webview_message_received = Message { $count } from the page: { $text }
webview_message_reply = The app received message { $count }.
webview_message_unsupported = This engine has no channel from the page to the app.
