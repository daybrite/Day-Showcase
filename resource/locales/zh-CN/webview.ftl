# The Web View page's page messages (src/pages/webview.rs).

webview_message_none = 尚未收到页面的消息。
webview_message_received = 来自页面的第 { $count } 条消息：{ $text }
webview_message_reply = 应用已收到第 { $count } 条消息。
webview_message_unsupported = 此引擎没有从页面到应用的通道。
