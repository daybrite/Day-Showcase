    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاينة الكاميرا والتقاط صورة في صفحة الكاميرا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview and take a photo on the Camera page."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher l'aperçu et prendre une photo sur la page Appareil photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“相机”页面预览并拍照。"
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض إحداثياتك مباشرةً في صفحة الجهاز والمستشعرات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show your coordinates live on the Device & sensors page."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher vos coordonnées en direct sur la page Appareil et capteurs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设备与传感器”页面实时显示您的坐标。"
          }
        }
      }
    },
